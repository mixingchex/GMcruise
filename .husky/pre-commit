#!/bin/sh

# Pre-commit Hook
# Fast, focused checks (<5 seconds target)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Pre-Commit Validation"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

START_TIME=$(date +%s)

# Track exit codes
EXIT_CODE=0

# 1. Security Check (Critical - blocks commit)
echo "⏳ [1/5] Security Check..."
if bash scripts/pre-commit-security-check.sh; then
  echo -e "${GREEN}✅ Security check passed${NC}"
else
  echo -e "${RED}❌ Security check failed${NC}"
  EXIT_CODE=1
fi
echo ""

# 2. Quality Check (Warning only)
echo "⏳ [2/5] Quality Check..."
if bash scripts/pre-commit-quality-check.sh; then
  echo -e "${GREEN}✅ Quality check passed${NC}"
else
  # Don't block on quality warnings
  echo -e "${YELLOW}⚠️  Quality warnings (not blocking)${NC}"
fi
echo ""

# 3. Type Check (Critical - blocks commit)
echo "⏳ [3/5] TypeScript Type Check..."
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  # Only check staged files for speed
  if npm run typecheck --silent 2>&1 | head -20; then
    echo -e "${GREEN}✅ Type check passed${NC}"
  else
    echo -e "${RED}❌ Type check failed${NC}"
    echo ""
    echo "Run 'npm run typecheck' to see all errors"
    EXIT_CODE=1
  fi
else
  echo "⏭️  No TypeScript files to check"
fi
echo ""

# 4. Lint Check (Critical - blocks commit)
echo "⏳ [4/5] ESLint Check..."
if [ -n "$STAGED_TS_FILES" ]; then
  # Lint only staged files
  if echo "$STAGED_TS_FILES" | xargs npm run lint --silent -- --max-warnings=10 2>&1 | tail -20; then
    echo -e "${GREEN}✅ Lint check passed${NC}"
  else
    echo -e "${RED}❌ Lint check failed${NC}"
    echo ""
    echo "Auto-fix available: npm run lint -- --fix"
    EXIT_CODE=1
  fi
else
  echo "⏭️  No files to lint"
fi
echo ""

# 5. Test Check (Fast - only critical tests)
echo "⏳ [5/5] Critical Tests..."
STAGED_TEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(test|spec)\.(ts|tsx)$' || true)

if [ -n "$STAGED_TEST_FILES" ]; then
  # Run only modified tests
  if npm test -- --passWithNoTests --testPathPattern="$(echo "$STAGED_TEST_FILES" | tr '\n' '|' | sed 's/|$//')" --silent 2>&1 | tail -15; then
    echo -e "${GREEN}✅ Tests passed${NC}"
  else
    echo -e "${RED}❌ Tests failed${NC}"
    EXIT_CODE=1
  fi
else
  # Run fast smoke test
  if npm test -- --passWithNoTests --testPathPattern="critical" --silent 2>&1 | tail -10; then
    echo -e "${GREEN}✅ Smoke tests passed${NC}"
  else
    echo -e "${YELLOW}⚠️  Some tests failed (not blocking)${NC}"
    # Don't block if no tests exist
  fi
fi
echo ""

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $EXIT_CODE -eq 0 ]; then
  echo -e "${GREEN}✅ All checks passed!${NC} (${DURATION}s)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 0
else
  echo -e "${RED}❌ Pre-commit checks failed${NC} (${DURATION}s)"
  echo ""
  echo "Fix the issues above and try again."
  echo "Or use 'git commit --no-verify' to skip (not recommended)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi
