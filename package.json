{
  "name": "cruise-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images:build": "node scripts/gen-image-manifest.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "dev": "bash scripts/dev-freeport.sh",
    "dev:test": "bash scripts/dev-test.sh",
    "build": "prisma generate && npm run images:build && npm run pwa:icons && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "convert": "node scripts/convert-csv.js",
    "seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate",
    "stop": "scripts/stop-dev.sh",
    "socket": "node server/socket-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run socket\"",
    "deploy:check": "bash scripts/pre-deploy-check.sh",
    "env:check": "node scripts/check-env.js",
    "check:env": "tsx scripts/check-env-before-deploy.ts",
    "migrate:check-env": "tsx scripts/check-migration-env.ts",
    "migrate:add-private-key": "tsx scripts/add-private-key.ts",
    "migrate:uploads": "tsx scripts/migrate-uploads-to-drive.ts",
    "migrate:db-paths": "tsx scripts/migrate-db-paths-to-drive.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "migrate:console:setup": "bash scripts/setup-jscodeshift.sh",
    "migrate:console:check": "bash scripts/pre-migration-check.sh",
    "migrate:console:count": "bash scripts/count-console-statements.sh",
    "migrate:console:tier1-dry": "bash scripts/run-migration.sh --dry",
    "migrate:console:tier1": "bash scripts/run-migration.sh",
    "migrate:console:test": "npx jscodeshift -t scripts/migrate-console-to-winston.js scripts/test-jscodeshift.ts --dry --print --parser=tsx",
    "migrate:console:affiliate-lib": "bash scripts/migrate-affiliate-lib.sh",
    "migrate:console:affiliate-api": "bash scripts/migrate-affiliate-api.sh",
    "test:type": "tsc --noEmit",
    "test:build": "npm run build",
    "test:contract-pdf": "tsx scripts/test-contract-pdf.ts",
    "generate-embeddings": "tsx scripts/generate-knowledge-embeddings.ts",
    "analyze": "ANALYZE=true npm run build",
    "create:sample-products": "tsx scripts/create-sample-products.ts",
    "update:dashboard-stats": "tsx scripts/update-dashboard-stats.ts",
    "apply:indexes": "tsx scripts/apply-indexes.ts",
    "create:dashboard-stats-table": "tsx scripts/create-dashboard-stats-table.ts",
    "simulate:admin-panel": "tsx scripts/simulate-admin-panel.ts",
    "test:redis": "tsx scripts/test-redis-connection.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "jest __tests__/e2e",
    "test:golden": "jest __tests__/golden",
    "test:critical": "jest --testPathPattern='(payment|affiliate|reservation)'",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "pre-commit:test": "bash scripts/pre-commit-test.sh",
    "pre-commit:fix": "bash scripts/fix-pre-commit-issues.sh",
    "security:check": "bash scripts/pre-commit-security-check.sh",
    "quality:check": "bash scripts/pre-commit-quality-check.sh",
    "prepare": "git config core.hooksPath .husky || true"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.23",
