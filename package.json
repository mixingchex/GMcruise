    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "puppeteer-core": "^24.32.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.10.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-select": "^5.10.2",
    "react-simple-maps": "^3.0.0",
    "react-speech-recognition": "^4.0.1",
    "react-webcam": "^7.2.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.3.0",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "signature_pad": "^4.1.7",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
