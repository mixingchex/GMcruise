    "@types/jscodeshift": "^0.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/react": "18.3.x",
    "@types/react-dom": "18.3.x",
    "@types/react-simple-maps": "^3.0.6",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/topojson-client": "^3.1.5",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "canvas": "^3.2.0",
